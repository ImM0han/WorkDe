{
  "expo": {
    "name": "WrkUp",
    "slug": "gigwork",
    "version": "1.0.0",
    "scheme": "wrkup",
    "sdkVersion": "54.0.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#1A0C02"
    },
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": false,
      "bundleIdentifier": "com.WrkUp.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "WrkUp uses your location to show nearby jobs.",
        "NSLocationAlwaysUsageDescription": "WrkUp tracks partner location so clients can track arrival.",
        "NSCameraUsageDescription": "Upload work completion photos.",
        "NSPhotoLibraryUsageDescription": "Upload certificates and profile photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCNOPjfxr6b4mgJT146ga9_Jf-yd0BU4ls"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A0C02"
      },
      "package": "com.WrkUp.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "WrkUp uses location for job matching."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6B1A"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "WrkUp needs photo access for uploads."
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "EXPO_PUBLIC_API_URL": "https://WrkUp-backend-production-2fa6.up.railway.app",
      "router": {},
      "eas": {
        "projectId": "a3064e11-9e80-4243-9183-3c8a8bfb42f0"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "wrkup"
  }
}
